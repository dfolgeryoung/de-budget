ALLOWED_EMAILS=david@example.com,elizabeth@example.com
# Phase 3+: service account JSON (base64) for the sheet mirror and Drive backups
GOOGLE_SERVICE_ACCOUNT_B64=
SHEET_ID=1qVck4ENuokjtccpJ47ADaqOr5KoJ4EddBOd1JU1i6D0
# Phase 5+: web push and email
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
